{
  "protocolVersion": 1,
  "methods": {
    "host.ready": {
      "description": "Confirm the current composition after its root UI rendered",
      "input": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "epoch": {
            "type": "string"
          }
        },
        "required": [
          "epoch"
        ]
      },
      "output": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "null"
      }
    },
    "host.status": {
      "description": "Read host readiness",
      "input": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {}
      },
      "output": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "ready": {
            "type": "boolean"
          },
          "epoch": {
            "type": "string"
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          },
          "namespaces": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "ready",
          "epoch",
          "error",
          "namespaces"
        ],
        "additionalProperties": false
      }
    },
    "host.recover": {
      "description": "Restart with previous or default plugin composition",
      "input": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "previous",
              "default"
            ]
          }
        },
        "required": [
          "mode"
        ]
      },
      "output": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "null"
      }
    }
  },
  "events": {
    "host.apis": {
      "description": "Available plugin API namespaces changed",
      "payload": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "namespaces": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "namespaces"
        ],
        "additionalProperties": false
      }
    }
  }
}
