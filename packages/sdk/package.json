{
  "name": "@semicoder/fn-sdk",
  "version": "0.6.0",
  "description": "TypeScript application SDK and tools for Fn",
  "homepage": "https://semicoder.dev/fn",
  "bugs": {
    "url": "https://github.com/semicoder-dev/fn/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/semicoder-dev/fn.git",
    "directory": "packages/sdk"
  },
  "files": [
    "src",
    "build.ts",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./backend": "./src/backend.ts",
    "./client": "./src/client.ts",
    "./contract": "./src/contract.ts",
    "./manifest": "./src/manifest.ts",
    "./widgets": "./src/widgets.ts",
    "./types": "./src/types.ts",
    "./react": "./src/react.tsx",
    "./sse": "./src/sse.ts",
    "./build": "./build.ts"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "dependencies": {
    "zod": "4.6.5"
  },
  "peerDependencies": {
    "react": ">=19 <20"
  },
  "engines": {
    "bun": ">=1.4.4"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
