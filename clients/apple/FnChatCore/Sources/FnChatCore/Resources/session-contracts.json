{
  "FnSessionCard": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "protocolVersion": {
        "type": "number",
        "const": 3
      },
      "id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160
      },
      "hostId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160
      },
      "sessionId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160
      },
      "card": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "sessionId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "createdAt": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "expiresAt": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "state": {
            "type": "string",
            "enum": [
              "pending",
              "running",
              "completed",
              "failed",
              "cancelled",
              "expired",
              "interrupted"
            ]
          },
          "card": {
            "type": "object",
            "properties": {
              "version": {
                "type": "number",
                "const": 1
              },
              "template": {
                "type": "string",
                "enum": [
                  "approval",
                  "choice",
                  "form"
                ]
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "summary": {
                "type": "string",
                "maxLength": 512
              },
              "blocks": {
                "maxItems": 30,
                "type": "array",
                "items": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "const": "text"
                        },
                        "text": {
                          "type": "string",
                          "maxLength": 16000
                        }
                      },
                      "required": [
                        "type",
                        "text"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "const": "fields"
                        },
                        "fields": {
                          "maxItems": 20,
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "label": {
                                "type": "string",
                                "maxLength": 200
                              },
                              "value": {
                                "type": "string",
                                "maxLength": 2000
                              }
                            },
                            "required": [
                              "label",
                              "value"
                            ],
                            "additionalProperties": false
                          }
                        }
                      },
                      "required": [
                        "type",
                        "fields"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "const": "divider"
                        }
                      },
                      "required": [
                        "type"
                      ],
                      "additionalProperties": false
                    }
                  ]
                }
              },
              "inputs": {
                "maxItems": 20,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100,
                      "pattern": "^[A-Za-z0-9_.-]+$"
                    },
                    "label": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    },
                    "type": {
                      "type": "string",
                      "enum": [
                        "text",
                        "number",
                        "boolean",
                        "select",
                        "multiSelect"
                      ]
                    },
                    "required": {
                      "type": "boolean"
                    },
                    "options": {
                      "minItems": 1,
                      "maxItems": 50,
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 100,
                            "pattern": "^[A-Za-z0-9_.-]+$"
                          },
                          "label": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 200
                          }
                        },
                        "required": [
                          "id",
                          "label"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "maxLength": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 16000
                    },
                    "minimum": {
                      "type": "number"
                    },
                    "maximum": {
                      "type": "number"
                    }
                  },
                  "required": [
                    "id",
                    "label",
                    "type",
                    "required"
                  ],
                  "additionalProperties": false
                }
              },
              "actions": {
                "minItems": 1,
                "maxItems": 10,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100,
                      "pattern": "^[A-Za-z0-9_.-]+$"
                    },
                    "label": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 80
                    },
                    "style": {
                      "type": "string",
                      "enum": [
                        "normal",
                        "primary",
                        "danger"
                      ]
                    }
                  },
                  "required": [
                    "id",
                    "label"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "version",
              "template",
              "title",
              "summary",
              "blocks",
              "inputs",
              "actions"
            ],
            "additionalProperties": false
          },
          "answer": {
            "type": "object",
            "properties": {
              "actionId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100,
                "pattern": "^[A-Za-z0-9_.-]+$"
              },
              "values": {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100,
                  "pattern": "^[A-Za-z0-9_.-]+$"
                },
                "additionalProperties": {
                  "anyOf": [
                    {
                      "type": "string",
                      "maxLength": 16000
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "boolean"
                    },
                    {
                      "maxItems": 50,
                      "type": "array",
                      "items": {
                        "type": "string",
                        "maxLength": 200
                      }
                    }
                  ]
                }
              }
            },
            "required": [
              "actionId",
              "values"
            ],
            "additionalProperties": false
          },
          "error": {
            "type": "string",
            "maxLength": 1024
          }
        },
        "required": [
          "id",
          "sessionId",
          "createdAt",
          "expiresAt",
          "state",
          "card"
        ],
        "additionalProperties": false
      }
    },
    "required": [
      "protocolVersion",
      "id",
      "hostId",
      "sessionId",
      "card"
    ],
    "additionalProperties": false
  },
