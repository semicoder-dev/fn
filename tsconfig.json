{
  "compilerOptions": {
    "strict": true,
    "skipLibCheck": true,
    "target": "ES2023",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "lib": ["ESNext", "DOM"],
    "types": ["bun", "vite/client"]
  },
  "include": [
    "host",
    "frontend",
    "plugins",
    "packages",
    "scripts",
    "tests",
    "fia.config.ts",
    "vite.config.ts",
    "commands"
  ]
}
