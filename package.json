{
  "name": "fn",
  "version": "0.8.3",
  "private": true,
  "homepage": "https://semicoder.dev/fn",
  "workspaces": [
    "packages/*",
    "framework/fia/packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun scripts/runtime-dev.ts",
    "agent": "fia agent",
    "run": "bun run prepare && bun framework/fia/tools/application-command.ts run",
    "build": "bun run prepare && bun framework/fia/tools/application-command.ts build",
    "release": "bun scripts/release/candidate.ts build",
    "version:app": "bun scripts/release/version.ts",
    "version:sdk": "bun scripts/npm/version.ts",
    "npm:check": "bun scripts/npm/check.ts",
    "npm:pack": "bun scripts/sdk-archive.ts && bun scripts/npm/pack.ts",
    "release:check": "bun scripts/release/check.ts",
    "release:check-update": "bun scripts/release/update-path.ts",
    "release:candidate": "bun scripts/release/candidate.ts build",
    "release:promote": "bun scripts/release/promote.ts",
    "release:runtime": "bun scripts/release/runtime.ts",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun run dependencies:check",
    "test": "bun scripts/build-runner.ts && bun test packages/host/tests packages/sdk/tests packages/ui/tests",
    "framework:prepare": "bun framework/fia/tools/prepare.ts",
    "framework:check": "bun framework/fia/tools/task.ts check",
    "framework:pack": "bun framework/fia/tools/task.ts pack",
    "framework:verify": "bun framework/fia/tools/verify-standalone.ts",
    "prepare": "bun run framework:prepare && bun scripts/build-runner.ts",
    "typecheck": "tsc --noEmit",
    "format": "bun fmt --no-script host frontend packages commands scripts fia.config.ts package.json tsconfig.json",
    "format:check": "bun fmt --no-script --check host frontend packages commands scripts fia.config.ts package.json tsconfig.json",
    "dependencies:check": "bun scripts/check-dependencies.ts",
    "lint": "oxlint --max-warnings=0 host frontend packages commands scripts"
  },
  "dependencies": {
    "@semicoder/fia": "workspace:*",
    "@semicoder/fn-host": "workspace:*",
    "@semicoder/fn-sdk": "workspace:*",
    "@semicoder/fn-ui": "workspace:*",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/bun": "1.4.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "oxlint": "^1.76.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "bun": ">=1.4.4"
  }
}
