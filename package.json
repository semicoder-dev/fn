{
  "name": "fn",
  "version": "0.5.2",
  "private": true,
  "homepage": "https://semicoder.dev/fn",
  "workspaces": [
    "packages/*",
    "framework/fia/packages/*",
    "plugins/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun scripts/runtime-dev.ts",
    "agent": "fia agent",
    "run": "bun run runtime:seed && bun framework/fia/tools/application-command.ts run",
    "build": "bun run runtime:seed && bun framework/fia/tools/application-command.ts build",
    "release": "bun run runtime:seed --distribution && bun framework/fia/tools/application-command.ts release",
    "release:update": "bun framework/fia/tools/application-command.ts release --update",
    "version:app": "bun scripts/release/version.ts",
    "version:sdk": "bun scripts/npm/version.ts",
    "npm:check": "bun scripts/npm/check.ts",
    "npm:pack": "bun scripts/npm/pack.ts",
    "release:check": "bun scripts/release/check.ts",
    "check": "bun run framework:check && bun run runtime:seed && fia check",
    "test": "bun test ./tests ./packages/host/tests ./packages/sdk/tests ./plugins",
    "styles:check": "bun scripts/check-styles.ts",
    "framework:prepare": "bun framework/fia/tools/prepare.ts",
    "framework:check": "bun framework/fia/tools/task.ts check",
    "framework:pack": "bun framework/fia/tools/task.ts pack",
    "framework:verify": "bun framework/fia/tools/verify-standalone.ts",
    "runtime:seed": "bun run plugins:build && bun scripts/runtime-seed.ts",
    "test:runtime": "bun test ./tests ./packages/host/tests ./packages/sdk/tests ./plugins",
    "upstream:verify": "bun scripts/upstream/verify.ts",
    "plugins:build": "bun scripts/build-plugins.ts"
  },
