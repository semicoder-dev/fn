{
  "name": "fn",
  "version": "0.5.0",
  "private": true,
  "homepage": "https://semicoder.dev/fn",
  "workspaces": [
    "packages/*",
    "framework/fia/packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun scripts/runtime-dev.ts",
    "agent": "fia agent",
    "run": "bun run sdk:snapshot && bun run runtime:seed && bun framework/fia/tools/application-command.ts run",
    "build": "bun run sdk:snapshot && bun run runtime:seed && bun framework/fia/tools/application-command.ts build",
    "release": "bun run sdk:snapshot && bun run runtime:seed && bun framework/fia/tools/application-command.ts release",
    "release:update": "bun framework/fia/tools/application-command.ts release --update",
    "version:app": "bun scripts/release/version.ts",
    "version:sdk": "bun scripts/npm/version.ts",
    "npm:check": "bun scripts/npm/check.ts",
    "npm:pack": "bun run sdk:styles && bun scripts/npm/pack.ts",
    "release:check": "bun scripts/release/check.ts",
    "check": "bun run framework:check && bun run styles:check && bun run sdk:snapshot && fia check",
    "test": "bun test ./tests packages/runtime/tests packages/sdk/tests backend/chat-next",
    "sdk:snapshot": "bun run sdk:styles && bun scripts/sdk-snapshot.ts",
    "styles:check": "bun scripts/check-styles.ts",
    "framework:prepare": "bun framework/fia/tools/prepare.ts",
    "framework:check": "bun framework/fia/tools/task.ts check",
    "framework:pack": "bun framework/fia/tools/task.ts pack",
    "framework:verify": "bun framework/fia/tools/verify-standalone.ts",
    "sdk:styles": "bun packages/sdk/styles.ts",
    "runtime:seed": "bun packages/sdk/generate-cordis-types.ts && bun scripts/runtime-seed.ts",
    "test:runtime": "bun test packages/runtime/tests packages/sdk/tests backend/chat-next",
    "upstream:verify": "bun scripts/upstream/verify.ts"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.0.2",
    "@semicoder/fia": "workspace:*",
    "@semicoder/fn-runtime": "workspace:*",
    "@semicoder/fn-sdk": "workspace:*",
    "agent-webtool": "0.8.2",
    "jose": "^6",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "1.4.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^5.0.0",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "^7.1.3"
  },
  "overrides": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/cosmokit": "1.8.6",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.2",
    "@deepseek-ai/dsh-agent-loop": "0.2.1-rc.2",
    "@deepseek-ai/dsh-atomic-write": "0.2.1-rc.2",
    "@deepseek-ai/dsh-attachment": "0.2.1-rc.2",
    "@deepseek-ai/dsh-authorization": "0.2.1-rc.2",
    "@deepseek-ai/dsh-brand": "0.2.1-rc.2",
    "@deepseek-ai/dsh-credentials": "0.2.1-rc.2",
    "@deepseek-ai/dsh-credentials-local": "0.2.1-rc.2",
    "@deepseek-ai/dsh-fs": "0.2.1-rc.2",
    "@deepseek-ai/dsh-home-paths": "0.2.1-rc.2",
    "@deepseek-ai/dsh-launch-environment": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm-pi-ai": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm-retry": "0.2.1-rc.2",
    "@deepseek-ai/dsh-ptc-runtime": "0.2.1-rc.2",
    "@deepseek-ai/dsh-sandbox": "0.2.1-rc.2",
    "@deepseek-ai/dsh-sandbox-policy": "0.2.1-rc.2",
    "@deepseek-ai/dsh-scope": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session-checkpoint-policy": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session-persistence": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session-projection": "0.2.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.2",
    "@deepseek-ai/dsh-timeout": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-rc.2",
    "@deepseek-ai/dsh-user-approval": "0.2.1-rc.2",
    "@deepseek-ai/dsh-util-crypto": "0.2.1-rc.2",
    "@deepseek-ai/dsh-util-values": "0.2.1-rc.2",
    "@deepseek-ai/dsh-working-directory": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "3.18.5"
  }
}
